# Copy this file to .env for local testing. NEVER commit the real .env file.
# On Render, you do NOT create a .env file — you paste these same keys into
# the Environment tab of your Web Service instead (see README.md, section I).

# Get this from @BotFather on Telegram after running /newbot
TELEGRAM_BOT_TOKEN=

# Get this from https://app.useinbox.email -> Developer -> API keys
INBOXMAIL_API_KEY=

# Your numeric Telegram user ID (get it from @userinfobot). Comma-separate
# multiple admins, e.g. 111111111,222222222
ADMIN_TELEGRAM_ID=

# Your custom domain configured on InboxMail
DOMAIN=deeptracex.online

# InboxMail aliases forward incoming mail to a real address (confirmed via
# their API — it's a forwarding service). Put YOUR real email here for now;
# every alias created by the bot forwards here until per-user destinations
# are worked out.
FORWARD_TO_EMAIL=

# Any long random string YOU make up — used to verify that webhook requests
# really came from Telegram. Example: openssl rand -hex 32
WEBHOOK_SECRET=

# Advanced / optional — safe to leave unset, defaults shown:
# INBOXMAIL_BASE_URL=https://api.useinbox.email
# DATABASE_PATH=tempmail.db
# INBOXMAIL_MAX_RETRIES=3
# INBOXMAIL_TIMEOUT_SECONDS=15

# Render sets this automatically in production — do NOT set it yourself
# unless you're testing webhook registration locally against a tunnel URL.
# RENDER_EXTERNAL_URL=
